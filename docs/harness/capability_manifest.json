      "title": "Cross-Tier Write Protection",
      "kind": "hook",
      "enforcement": "hard",
      "scripts": [
        "scripts/check_src_write_authorization.py",
        "scripts/check_bash_code_write.py",
        "scripts/check_cross_tier_compliance.py"
      ],
      "docs": ["docs/hooks_reference.md", "skills/implementation-agent/SKILL.md"],
      "artifact_paths": ["docs/gates/agent_spawn_log.md"],
      "workflow_gate_keys": []
    },
    {
      "id": "workflow-sync",
      "title": "Workflow Sync",
      "kind": "workflow",
      "enforcement": "deterministic",
      "scripts": ["scripts/sync_workflow.py", "scripts/workflow_hooks.py"],
