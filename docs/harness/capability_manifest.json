      "scripts": ["scripts/check_orient_recorded.py"],
      "docs": ["skills/task-intake/SKILL.md", "docs/hooks_reference.md"],
      "artifact_paths": ["docs/gates/orient_note.md"],
      "workflow_gate_keys": ["orient_gate"]
    },
    {
      "id": "interview-gate",
      "title": "Interview Gate",
      "kind": "gate",
      "enforcement": "hard",
      "scripts": ["scripts/check_interview_recorded.py"],
