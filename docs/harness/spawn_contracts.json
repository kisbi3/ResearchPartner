      "runtime_enforcement": "Claude Code loads .claude/agents/cache-log-auditor.md and applies its tools frontmatter; check_spawn_contracts.py enforces static consistency only."
    },
    {
      "role": "peer-review-professor",
      "agent_file": ".claude/agents/peer-review-professor.md",
      "skill": "skills/peer-review-professor/SKILL.md",
      "allowed_tools": ["Read", "Grep", "Glob"],
      "write_scope": [],
