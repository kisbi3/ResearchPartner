{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/enforce_gate_sequence.py\""},
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/workflow_hooks.py\" pre"},
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/check_peer_review_invocation.py\""}
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/check_src_write_authorization.py\""},
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/path_check_hooks.py\" pre"}
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/check_bash_code_write.py\""},
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/check_seed_before_full_run.py\""},
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/warn_orphan_checkpoints.py\""}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/workflow_hooks.py\" post"},
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/check_spawn_log_integrity.py\""}
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/path_check_hooks.py\" post"}
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.harness/scripts/path_check_hooks.py\" post"}
        ]
      }
    ]
  }
}
