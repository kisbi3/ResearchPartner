# Python runtime artifacts
__pycache__/
*.py[cod]
*$py.class

# Test/cache artifacts
.pytest_cache/

# Local tool state
.sixth/

# Local generated outputs for ad hoc runs
outputs/

# Virtual environments
.venv/
venv/

# Research runs (live workflow state, per-run outputs, cache, errors).
